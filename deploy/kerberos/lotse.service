# Lotse on Linux with Windows sign-in (Kerberos). Copy to /etc/systemd/system/lotse.service, adjust paths,
# then: systemctl daemon-reload && systemctl enable --now lotse
# Prerequisites: see deploy/kerberos/README.md (keytab, krb5.conf, pip install "pyspnego[kerberos]").
[Unit]
Description=Lotse intranet
After=network-online.target
Wants=network-online.target

[Service]
User=lotse
WorkingDirectory=/opt/lotse/backend
Environment=KRB5_KTNAME=/etc/lotse/http.keytab
ExecStart=/opt/lotse/backend/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 443 \
    --ssl-certfile /etc/lotse/cert.pem --ssl-keyfile /etc/lotse/key.pem
# port 443 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
