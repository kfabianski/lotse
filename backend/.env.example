# Copy to backend/.env and adjust. All keys are optional.
LOTSE_COMPANY_NAME=Muster GmbH
# true = everyone can read without signing in; sign-in only to post, vote or edit
LOTSE_PUBLIC_READ=true
# LOTSE_SECRET_KEY=   # leave empty: a random key is generated once in data/.secret_key
# LOTSE_CORS_ORIGINS=["http://localhost:5173"]

# --- LDAP / Active Directory (LDAPS with certificate check) ---
LOTSE_LDAP_ENABLED=false
# Server: host name or IP address, e.g. 10.0.0.5
LOTSE_LDAP_HOST=dc01.firma.local
LOTSE_LDAP_PORT=636
# ldaps (port 636) or starttls (port 389)
LOTSE_LDAP_MODE=ldaps


# PEM file with your company root CA (empty = Windows/Linux trust store):
LOTSE_LDAP_CA_FILE=
LOTSE_LDAP_BIND_DN=CN=svc-intranet,OU=Service,DC=firma,DC=local
LOTSE_LDAP_BIND_PASSWORD=
LOTSE_LDAP_BASE_DN=OU=Mitarbeiter,DC=firma,DC=local
LOTSE_LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
# Group DNs that grant roles (checked on every login and sync):
LOTSE_LDAP_ADMIN_GROUP=CN=Intranet-Admins,OU=Gruppen,DC=firma,DC=local
LOTSE_LDAP_EDITOR_GROUP=CN=Intranet-Redaktion,OU=Gruppen,DC=firma,DC=local
